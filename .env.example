# Copy to .env.local for local development (never commit .env.local).
# On Vercel, add these under Project → Settings → Environment Variables.

# Password for the control center at /admin (at least 8 characters)
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: separate secret for signing login sessions.
# If set, changing it logs everyone out.
# ADMIN_SESSION_SECRET=

# Added automatically when you connect storage in Vercel → Storage:
# KV_REST_API_URL=          (Upstash for Redis — stores the catalog)
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=    (Vercel Blob — stores product photos)
